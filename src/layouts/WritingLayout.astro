---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  tags: string[];
  canonicalPath: string;
  noIndex?: boolean;
}

const { title, description, publishedAt, tags, canonicalPath, noIndex = false } = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: publishedAt.toISOString(),
  author: {
    '@type': 'Person',
    name: 'Rene Gonzalez',
    url: 'https://reneleo.com',
  },
  mainEntityOfPage: canonicalUrl,
};
---

<BaseLayout title={title} description={description} type="article" schema={schema} noIndex={noIndex}>
  <main id="main-content" class="article-page">
    <article>
      <header class="article-header">
        <a class="back-link" href="/pensieve/">← Notebook</a>
        <time datetime={publishedAt.toISOString()}>
          {
            publishedAt.toLocaleDateString('en-CA', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })
          }
        </time>
        <h1>{title}</h1>
        <p>{description}</p>
        <div class="tag-list" aria-label="Tags">
          {tags.map(tag => <span>{tag}</span>)}
        </div>
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>