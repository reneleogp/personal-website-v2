---
import { getEntry } from 'astro:content';
import BackgroundCanvas from './BackgroundCanvas';

const profile = await getEntry('profile', 'main');

if (!profile) {
  throw new Error('Profile content is missing.');
}
---

<section class="hero" aria-labelledby="hero-title">
  <BackgroundCanvas client:load />
  <div class="hero-inner">
    <h1 id="hero-title">{profile.data.name}</h1>
    <p class="hero-copy">
      I am a software engineer based in {profile.data.location}. {profile.data.hero.professional}
      {' '}{profile.data.hero.personal}
    </p>

    <p class="workplaces">
      I have worked at{' '}
      {
        profile.data.workplaces.map((workplace, index) => (
          <>
            <a href={workplace.url}>{workplace.name}</a>
            {index < profile.data.workplaces.length - 2 && <span aria-hidden="true">, </span>}
            {index === profile.data.workplaces.length - 2 && <span aria-hidden="true">, and </span>}
          </>
        ))
      }
      .
    </p>

    <div class="hero-links" aria-label="Profile links">
      {profile.data.social.map(item => <a href={item.url}>{item.name}</a>)}
      <a href={`mailto:${profile.data.email}`}>Email</a>
      <a href={profile.data.resume}>Resume</a>
    </div>
  </div>
</section>
