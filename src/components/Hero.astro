---
import { getEntry } from 'astro:content';

const profile = await getEntry('profile', 'main');

if (!profile) {
  throw new Error('Profile content is missing.');
}
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-inner">
    <p class="eyebrow">Software engineer · {profile.data.location}</p>
    <h1 id="hero-title">{profile.data.name}</h1>
    <div class="hero-copy">
      <p>{profile.data.hero.professional}</p>
      <p class="hero-personal">{profile.data.hero.personal}</p>
    </div>

    <p class="workplaces">
      <span>Previously</span>
      {
        profile.data.workplaces.map((workplace, index) => (
          <>
            <a href={workplace.url}>{workplace.name}</a>
            {index < profile.data.workplaces.length - 1 && <span aria-hidden="true"> / </span>}
          </>
        ))
      }
    </p>

    <div class="hero-actions">
      <a class="text-link" href="#timeline">Follow the timeline <span aria-hidden="true">↓</span></a>
      <a class="text-link text-link-muted" href={profile.data.resume}>Resume <span aria-hidden="true">↗</span></a>
    </div>

    <div class="field-mark" aria-hidden="true">
      <span>43.6532 N</span>
      <span>79.3832 W</span>
      <span class="field-mark-line"></span>
      <span>FIELD NOTES / 03</span>
    </div>
  </div>
</section>