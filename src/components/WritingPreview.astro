---
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((first, second) => second.data.date.valueOf() - first.data.date.valueOf())
  .slice(0, 3);
---

<section class="writing-preview" aria-labelledby="writing-preview-title">
  <div class="section-intro">
    <p class="section-index" aria-hidden="true">02 / NOTEBOOK</p>
    <h2 id="writing-preview-title">Things worth remembering.</h2>
  </div>
  <div class="writing-list">
    {
      posts.map(post => (
        <article>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('en-CA', { year: 'numeric', month: 'short' })}
          </time>
          <h3><a href={`${post.data.slug}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
          <span aria-hidden="true">↗</span>
        </article>
      ))
    }
  </div>
  <a class="text-link" href="/pensieve/">Open the notebook <span aria-hidden="true">→</span></a>
</section>