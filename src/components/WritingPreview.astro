---
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((first, second) => second.data.date.valueOf() - first.data.date.valueOf())
  .slice(0, 3);
---

<section class="home-section writing-preview" aria-labelledby="writing-preview-title">
  <div class="section-heading">
    <h2 id="writing-preview-title">Notes</h2>
  </div>
  <div class="simple-list writing-list">
    {
      posts.map(post => (
        <article>
          <h3><a href={`${post.data.slug}/`}>{post.data.title}</a></h3>
          <p>{post.data.description}</p>
        </article>
      ))
    }
  </div>
  <a class="section-link" href="/pensieve/">All notes →</a>
</section>
