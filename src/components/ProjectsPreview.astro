---
import { getCollection, render } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => data.showInProjects))
  .sort((first, second) => Number(first.data.date) - Number(second.data.date))
  .slice(0, 5);

const items = await Promise.all(
  projects.map(async project => ({
    project,
    Content: (await render(project)).Content,
  })),
);
---

<section class="home-section" aria-labelledby="projects-title">
  <div class="section-heading">
    <h2 id="projects-title">Projects</h2>
  </div>
  <div class="simple-list">
    {
      items.map(({ project, Content }) => {
        const url = project.data.external || project.data.github;
        return (
          <article>
            <h3>{url ? <a href={url}>{project.data.title}</a> : project.data.title}</h3>
            <div><Content /></div>
          </article>
        );
      })
    }
  </div>
  <a class="section-link" href="/archive/">All projects →</a>
</section>