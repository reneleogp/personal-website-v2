---
import { getCollection } from 'astro:content';
import TimelineExplorer from './timeline/TimelineExplorer';

const entries = (await getCollection('timeline', ({ data }) => !data.draft && data.featured)).sort(
  (first, second) => second.data.startDate.valueOf() - first.data.startDate.valueOf(),
);

const timelineItems = entries.map(entry => ({
  id: entry.id,
  title: entry.data.title,
  organization: entry.data.organization,
  startDate: entry.data.startDate.toISOString(),
  kind: entry.data.kind,
  location: entry.data.location,
  media:
    entry.data.media.kind === 'image'
      ? { ...entry.data.media, src: entry.data.media.src.src }
      : entry.data.media.kind === 'video'
        ? { ...entry.data.media, poster: entry.data.media.poster?.src }
        : entry.data.media,
  notes: entry.data.kind === 'work' ? [] : entry.data.notes,
  links: entry.data.links,
}));
---

<section class="home-section timeline-section" id="timeline" aria-labelledby="timeline-title">
  <div class="section-heading">
    <h2 id="timeline-title">Timeline</h2>
    <p>A small log of work, travel, and other things worth remembering.</p>
  </div>
  <TimelineExplorer items={timelineItems} client:visible />
</section>
