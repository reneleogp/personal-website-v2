---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { postPath, slugify } from '../../../utils/slug';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap(post => post.data.tags))];

  return tags.map(tag => ({
    params: { tag: slugify(tag) },
    props: { tag, posts: posts.filter(post => post.data.tags.includes(tag)) },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'writing'>[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`${tag} notes`} description={`Writing by Rene Gonzalez tagged ${tag}.`}>
  <main id="main-content" class="notebook-page tag-page">
    <header class="page-header">
      <a class="back-link" href="/pensieve/">← Notebook</a>
      <p class="section-index">TAGGED / {tag}</p>
      <h1>{tag}</h1>
      <p>{posts.length} {posts.length === 1 ? 'note' : 'notes'} in this part of the notebook.</p>
    </header>
    <div class="notebook-list">
      {
        posts.map((post, index) => (
          <article>
            <span class="project-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <time datetime={post.data.date.toISOString()}>{post.data.date.getFullYear()}</time>
            <div>
              <h2><a href={postPath(post.data.slug)}>{post.data.title}</a></h2>
              <p>{post.data.description}</p>
            </div>
            <span aria-hidden="true">↗</span>
          </article>
        ))
      }
    </div>
  </main>
</BaseLayout>