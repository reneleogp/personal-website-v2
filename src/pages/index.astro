---
import Hero from '../components/Hero.astro';
import ProjectsPreview from '../components/ProjectsPreview.astro';
import TimelineSection from '../components/TimelineSection.astro';
import WritingPreview from '../components/WritingPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const description = 'Software engineer, builder, and occasional backpacker.';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Rene Gonzalez',
    url: 'https://reneleo.com',
    email: 'mailto:reneleogp0305@gmail.com',
    sameAs: ['https://github.com/reneleogp', 'https://www.linkedin.com/in/reneleogp'],
    jobTitle: 'Software Engineer',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Rene Gonzalez',
    url: 'https://reneleo.com',
    description,
  },
];
---

<BaseLayout title="Rene Gonzalez" description={description} schema={schema}>
  <main id="main-content">
    <Hero />
    <TimelineSection />
    <ProjectsPreview />
    <WritingPreview />
  </main>
</BaseLayout>
