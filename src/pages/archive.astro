---
import { getCollection } from 'astro:content';
import ProjectRow from '../components/ProjectRow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects', ({ data }) => data.showInProjects)).sort((first, second) => {
  const firstDate = Number.parseInt(first.data.date, 10);
  const secondDate = Number.parseInt(second.data.date, 10);
  return Number.isNaN(firstDate) || Number.isNaN(secondDate) ? 0 : firstDate - secondDate;
});
---

<BaseLayout
  title="Projects"
  description="Selected software projects and experiments by Rene Gonzalez.">
  <main id="main-content" class="archive-page">
    <header class="page-header">
      <h1>Projects</h1>
      <p>Things I have built, shipped, or learned from.</p>
    </header>
    <div class="project-list">
      {projects.map(project => <ProjectRow project={project} />)}
    </div>
  </main>
</BaseLayout>
